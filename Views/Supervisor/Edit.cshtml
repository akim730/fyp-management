@model fypSystem.Models.Supervisor

@{
    ViewData["Title"] = "Edit Supervisor";
}

<h1 class="text-2xl font-bold mb-4">Edit Supervisor</h1>

<h4 class="mb-3">Supervisor Information</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" /> @* Hidden field for the Supervisor Id *@

            <div class="form-group mb-3">
                <label asp-for="LecturerId" class="control-label"></label>
                <select asp-for="LecturerId" class="form-control" asp-items="ViewBag.LecturerId"></select>
                <span asp-validation-for="LecturerId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SupervisorType" class="control-label"></label>
                <input asp-for="SupervisorType" class="form-control" />
                <span asp-validation-for="SupervisorType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MaxStudents" class="control-label"></label>
                <input asp-for="MaxStudents" class="form-control" />
                <span asp-validation-for="MaxStudents" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}