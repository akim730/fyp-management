@model fypSystem.Models.ProjectProposal

@{
    ViewData["Title"] = "View Student Proposal";
}

<h1 class="text-2xl font-bold mb-4">Project Proposal for @Model.Student.Name (@Model.Student.StudentNo)</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Proposal Details</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ProjectType)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ProjectType)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SubmissionDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SubmissionDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Status == fypSystem.Models.ProposalStatus.Approved ? "bg-success" :
                                            Model.Status == fypSystem.Models.ProposalStatus.Rejected ? "bg-danger" :
                                            Model.Status == fypSystem.Models.ProposalStatus.ResubmissionRequired ? "bg-warning text-dark" :
                                            "bg-secondary")">
                    @Html.DisplayFor(model => model.Status)
                </span>
            </dd>

            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <dt class="col-sm-3">Uploaded File</dt>
                <dd class="col-sm-9">
                    <a asp-controller="ProjectProposal" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-info" target="_blank">Download Proposal PDF</a>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-secondary text-white">
        <h4 class="mb-0">Supervisor Comments</h4>
    </div>
    <div class="card-body">
        <form asp-action="SaveProposalComment" asp-controller="Supervisor" method="post">
            <input type="hidden" name="id" value="@Model.Id" /> @* Pass the ProjectProposal Id *@
            <div class="mb-3">
                <label for="committeeFeedback" class="form-label">Your Comments:</label>
                <textarea class="form-control" id="committeeFeedback" name="committeeFeedback" rows="5">@Model.CommitteeFeedback</textarea>
                <small class="form-text text-muted">These comments will be visible to the student.</small>
            </div>
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary">Save Comment</button>
            </div>
        </form>
    </div>
    @if (!string.IsNullOrEmpty(Model.CommitteeFeedback) && Model.ReviewDate.HasValue)
    {
        <div class="card-footer text-muted">
            Last commented on: @Model.ReviewDate.Value.ToString("yyyy-MM-dd HH:mm")
        </div>
    }
</div>

<div class="mt-4">
    <a asp-action="AssignedProjects" class="btn btn-secondary">Back to Assigned Students</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}