@model IEnumerable<fypSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1 class="text-2xl font-bold mb-4">Students</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(m => m.StudentNo)</th>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>@Html.DisplayNameFor(m => m.Email)</th>
                <th>@Html.DisplayNameFor(m => m.Gender)</th>
                <th>@Html.DisplayNameFor(m => m.AcademicProgram)</th>
                <th>@Html.DisplayNameFor(m => m.AcademicSession)</th> @* Added Academic Session header *@
                <th>@Html.DisplayNameFor(m => m.Semester)</th> @* Added Semester header *@
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(_ => item.StudentNo)</td>
                    <td>@Html.DisplayFor(_ => item.Name)</td>
                    <td>@Html.DisplayFor(_ => item.Email)</td>
                    <td>@Html.DisplayFor(_ => item.Gender)</td>
                    <td>@Html.DisplayFor(_ => item.AcademicProgram.Name)</td>
                    <td>@Html.DisplayFor(_ => item.AcademicSession)</td> @* Display Academic Session *@
                    <td>@Html.DisplayFor(_ => item.Semester)</td> @* Display Semester *@
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary ms-1">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>