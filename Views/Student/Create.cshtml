@model fypSystem.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<h1 class="text-2xl font-bold mb-4">Create Student</h1>

<h4 class="mb-3">Student</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="StudentNo" class="control-label"></label>
                <input asp-for="StudentNo" class="form-control" />
                <span asp-validation-for="StudentNo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DateOfBirth" class="control-label"></label>
                <input asp-for="DateOfBirth" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Gender" class="control-label"></label>
                <select asp-for="Gender" class="form-control">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label"></label>
                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AcademicProgramId" class="control-label"></label>
                <select asp-for="AcademicProgramId" class="form-control" asp-items="ViewBag.AcademicProgramId"></select>
                <span asp-validation-for="AcademicProgramId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CGPA" class="control-label"></label>
                <input asp-for="CGPA" class="form-control" />
                <span asp-validation-for="CGPA" class="text-danger"></span>
            </div>
            @* NEW FIELDS: Academic Session and Semester - NOW AS DROPDOWNS *@
            <div class="form-group mb-3">
                <label asp-for="AcademicSession" class="control-label"></label>
                <select asp-for="AcademicSession" class="form-control" asp-items="ViewBag.AcademicSessions">
                    <option value="">-- Select Academic Session --</option>
                </select>
                <span asp-validation-for="AcademicSession" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Semester" class="control-label"></label>
                <select asp-for="Semester" class="form-control" asp-items="ViewBag.Semesters">
                    <option value="">-- Select Semester --</option>
                </select>
                <span asp-validation-for="Semester" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
