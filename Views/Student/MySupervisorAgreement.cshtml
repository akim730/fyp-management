@model fypSystem.Models.StudentSupervisor 

@{
    ViewData["Title"] = "My Supervisor Agreement";
    string agreementText = ViewBag.AgreementText as string ?? "Agreement text not available."; // Get agreement text from ViewBag
}

<h1 class="text-2xl font-bold mb-4">My Supervisor Agreement</h1>

@if (Model != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Your Supervisor Assignment Details</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-4">Student Name</dt>
                <dd class="col-sm-8">@Model.Student.Name</dd>

                <dt class="col-sm-4">Matric No.</dt>
                <dd class="col-sm-8">@Model.Student.StudentNo</dd>

                <dt class="col-sm-4">Student Program</dt>
                <dd class="col-sm-8">@Model.Student.AcademicProgram?.Name</dd>

                <dt class="col-sm-4">Academic Session</dt>
                <dd class="col-sm-8">@Model.Student.AcademicSession</dd>

                <dt class="col-sm-4">Semester</dt>
                <dd class="col-sm-8">@Model.Student.Semester</dd>
            </dl>

            <h5 class="mt-4 mb-3 text-secondary">Assigned Supervisor</h5>
            <dl class="row">
                <dt class="col-sm-4">Supervisor Name</dt>
                <dd class="col-sm-8">@Model.Supervisor.Lecturer.Name</dd>

                <dt class="col-sm-4">Supervisor Type</dt>
                <dd class="col-sm-8">@Model.SupervisorType</dd>

                <dt class="col-sm-4">Supervisor's Program</dt>
                <dd class="col-sm-8">@Model.Supervisor.Lecturer.AcademicProgram?.Name</dd>

                <dt class="col-sm-4">Assignment Approved On</dt>
                <dd class="col-sm-8">@((Model.ActionDate.HasValue ? Model.ActionDate.Value.ToString("dd MMMM yyyy") : "N/A"))</dd>

                @if (!string.IsNullOrEmpty(Model.CommitteeRemarks))
                {
                    <dt class="col-sm-4">Committee Remarks</dt>
                    <dd class="col-sm-8">@Model.CommitteeRemarks</dd>
                }
            </dl>

            <h5 class="mt-5 mb-3 text-primary">General Agreement Terms</h5>
            <div class="alert alert-success" role="alert">
                <p class="lead mb-0">
                    @Html.Raw(agreementText) @* Display the dynamically generated agreement text *@
                </p>
                <hr />
                <p class="mb-0 text-muted small">
                    <em>This agreement signifies the formal acknowledgment of your supervisor assignment. Both the student and the supervisor are expected to adhere to the university's academic policies and project guidelines throughout the Final Year Project duration.</em>
                </p>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">No Supervisor Agreement Found!</h4>
        <p>It appears that your Final Year Project supervisor assignment has not yet been approved by the committee, or you have not yet been assigned a supervisor.</p>
        <p class="mb-0">Please check back at a later time. If you believe there's an error or need immediate assistance, kindly reach out to your academic advisor or the FYP coordinator.</p>
    </div>
}

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</div>