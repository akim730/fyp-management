@model fypSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h1 class="text-2xl font-bold mb-4">Student Details</h1>

<div>
    <h4 class="mb-3">Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentNo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.StudentNo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DateOfBirth)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Gender)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Gender)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PhoneNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AcademicProgram)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AcademicProgram.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CGPA)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CGPA)</dd>

        @* NEW FIELDS: Academic Session and Semester *@
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AcademicSession)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AcademicSession)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Semester)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Semester)</dd>
    </dl>
</div>
<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
</div>