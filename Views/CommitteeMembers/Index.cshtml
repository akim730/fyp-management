@model IEnumerable<fypSystem.Models.ProjectProposal>
@using fypSystem.Models

@{
    ViewData["Title"] = "Manage Project Proposals (Committee)";
}

<h1 class="text-2xl font-bold mb-4">Manage Project Proposals (Committee)</h1>


@* TempData Messages using Bootstrap Alerts *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">Filter Proposals</h5>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="semesterFilter" class="form-label">Semester</label>
                <select name="semesterFilter" id="semesterFilter" class="form-select" asp-items="ViewBag.Semesters"></select>
            </div>
            <div class="col-md-4">
                <label for="academicSessionFilter" class="form-label">Academic Session</label>
                <select name="academicSessionFilter" id="academicSessionFilter" class="form-select" asp-items="ViewBag.AcademicSessions"></select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Apply Filter</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Clear Filter</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">All Project Proposals</h5>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info" role="alert">
                No project proposals found matching the current filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th>Student</th>
                            <th>@Html.DisplayNameFor(model => model.ProjectType)</th>
                            <th>@Html.DisplayNameFor(model => model.SubmissionDate)</th>
                            <th>@Html.DisplayNameFor(model => model.AcademicSession)</th>
                            <th>@Html.DisplayNameFor(model => model.Semester)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>Main Supervisor</th>
                            <th>Evaluator 1</th>
                            <th>Evaluator 2</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                <td>@Html.DisplayFor(modelItem => item.Student.Name) (@Html.DisplayFor(modelItem => item.Student.StudentNo))</td>
                                <td>@Html.DisplayFor(modelItem => item.ProjectType)</td>
                                <td>@Html.DisplayFor(modelItem => item.SubmissionDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.AcademicSession)</td>
                                <td>@Html.DisplayFor(modelItem => item.Semester)</td>
                                <td>
                                    <span class="badge
                                                @(item.Status == ProposalStatus.Approved ? "bg-success" :
                                                                                    item.Status == ProposalStatus.Rejected ? "bg-danger" :
                                                                                    item.Status == ProposalStatus.ResubmissionRequired || item.Status == ProposalStatus.AcceptedWithConditions ? "bg-warning text-dark" :
                                                                                    "bg-secondary")">
                                @Html.DisplayFor(modelItem => item.Status)
                            </span>
                        </td>
                        <td>@(item.MainSupervisorLecturer?.Name ?? "N/A")</td>
                        <td>@(item.Evaluator1?.Name ?? "N/A")</td>
                        <td>@(item.Evaluator2?.Name ?? "N/A")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.FilePath))
                                    {
                                        <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" target="_blank">PDF</a>
                                    }
                                    <a asp-action="CommitteeProjectDetails" asp-route-id="@item.Id" class="btn btn-sm btn-secondary me-1">Details</a>
                                    <a asp-action="AssignEvaluators" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">Assign</a>
                                    <a asp-action="ReviewProposal" asp-route-id="@item.Id" class="btn btn-sm btn-success">Review</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
