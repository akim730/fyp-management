@model fypSystem.Models.CommitteeMember

@{
    ViewData["Title"] = "Delete Committee Member";
}

<h1 class="text-2xl font-bold mb-4">Delete Committee Member</h1>

<h3 class="text-danger">Are you sure you want to delete this committee member?</h3>
<div>
    <h4 class="mb-3">Lecturer Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Lecturer.StaffNo)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Lecturer.StaffNo)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Lecturer.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Lecturer.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Lecturer.Email)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Lecturer.Email)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Lecturer.AcademicProgram)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Lecturer.AcademicProgram.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Lecturer.AcademicRank)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Lecturer.AcademicRank)
        </dd>
    </dl>

    <h4 class="mt-4 mb-3">Committee Role Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CommitteeRole)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CommitteeRole)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AppointmentDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AppointmentDate)
        </dd>
        @* Uncomment this block if CommitteeMember model has AcademicProgramId *@
        @*
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AcademicProgram)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AcademicProgram.Name)
        </dd>
        *@
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>