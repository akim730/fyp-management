@model fypSystem.Models.ProjectProposal
@using fypSystem.Models

@{
    ViewData["Title"] = "Finalize Review for: " + Model.Title;
}

<h1 class="display-4 mb-4">Finalize Review for: "@Model.Title"</h1>

<h4 class="mb-3">Proposal Information</h4>
<hr />

@* TempData Messages using Bootstrap Alerts *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">Proposal Details</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-3">Student Name:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Student.Name) (@Html.DisplayFor(model => model.Student.StudentNo))</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ProjectType)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ProjectType)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SubmissionDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SubmissionDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AcademicSession)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.AcademicSession)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Semester)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Semester)</dd>

            <dt class="col-sm-3">Current Status:</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Status == ProposalStatus.Approved ? "bg-success" :
                                            Model.Status == ProposalStatus.Rejected ? "bg-danger" :
                                            Model.Status == ProposalStatus.ResubmissionRequired || Model.Status == ProposalStatus.AcceptedWithConditions ? "bg-warning text-dark" :
                                            "bg-secondary")">
                    @Html.DisplayFor(model => Model.Status)
                </span>
            </dd>

            @if (Model.MainSupervisorLecturer != null)
            {
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MainSupervisorLecturer)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MainSupervisorLecturer.Name)</dd>
            }

            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <dt class="col-sm-3">Proposal File:</dt>
                <dd class="col-sm-9">
                    <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-info" target="_blank">Download Proposal PDF</a>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-secondary text-white">
        <h4 class="mb-0">Evaluator Feedback Summary</h4>
    </div>
    <div class="card-body">
        @if (Model.Evaluator1 == null && Model.Evaluator2 == null)
        {
            <div class="alert alert-info" role="alert">
                No evaluators have been assigned to this proposal yet.
            </div>
        }
        else
        {
            <h5 class="mt-3">Evaluator 1: @(Model.Evaluator1?.Name ?? "Not Assigned")</h5>
            @if (Model.Evaluator1 != null)
            {
                <dl class="row">
                    <dt class="col-sm-3">Recommendation:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Evaluator1Recommendation.HasValue)
                        {
                            <span class="badge
                                            @(Model.Evaluator1Recommendation == ProposalStatus.Approved ? "bg-success" :
                                                                    Model.Evaluator1Recommendation == ProposalStatus.Rejected ? "bg-danger" :
                                                                    Model.Evaluator1Recommendation == ProposalStatus.AcceptedWithConditions ? "bg-warning text-dark" :
                                                                    "bg-secondary")">
                    @Html.DisplayFor(model => model.Evaluator1Recommendation)
                </span>
                                }
                        else
                        {
                            <span class="text-muted">Not yet submitted</span>
                        }
                    </dd>
                    <dt class="col-sm-3">Comments:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Evaluator1Feedback) ? "No comments provided." : Model.Evaluator1Feedback)</dd>
                </dl>
            }

            <hr class="my-3" />

            <h5 class="mt-3">Evaluator 2: @(Model.Evaluator2?.Name ?? "Not Assigned")</h5>
            @if (Model.Evaluator2 != null)
            {
                <dl class="row">
                    <dt class="col-sm-3">Recommendation:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Evaluator2Recommendation.HasValue)
                        {
                            <span class="badge
                                            @(Model.Evaluator2Recommendation == ProposalStatus.Approved ? "bg-success" :
                                                                    Model.Evaluator2Recommendation == ProposalStatus.Rejected ? "bg-danger" :
                                                                    Model.Evaluator2Recommendation == ProposalStatus.AcceptedWithConditions ? "bg-warning text-dark" :
                                                                    "bg-secondary")">
                    @Html.DisplayFor(model => model.Evaluator2Recommendation)
                </span>
                                }
                        else
                        {
                            <span class="text-muted">Not yet submitted</span>
                        }
                    </dd>
                    <dt class="col-sm-3">Comments:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Evaluator2Feedback) ? "No comments provided." : Model.Evaluator2Feedback)</dd>
                </dl>
            }
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Committee Decision</h4>
    </div>
    <div class="card-body">
        <form asp-action="ReviewProposal" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="finalStatus" class="form-label">Final Proposal Status</label>
                <select id="finalStatus" name="finalStatus" class="form-select" asp-items="ViewBag.FinalStatuses">
                    <option value="">-- Select Final Status --</option>
                </select>
                <span class="text-danger">@Html.ValidationMessage("finalStatus")</span>
            </div>

            <div class="mb-3">
                <label for="committeeFeedback" class="form-label">Committee Feedback</label>
                <textarea id="committeeFeedback" name="committeeFeedback" class="form-control" rows="5">@Model.CommitteeFeedback</textarea>
                <span class="text-danger">@Html.ValidationMessage("committeeFeedback")</span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">Finalize Decision</button>
                <a asp-action="CommitteeProjectDetails" asp-route-id="@Model.Id" class="btn btn-secondary ms-2">Back to Details</a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to All Proposals</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
