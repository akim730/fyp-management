@model fypSystem.Models.ProjectProposal

@{
    ViewData["Title"] = "Assign Evaluators";
}

<h1 class="text-2xl font-bold mb-4">Assign Evaluators for Project: "@Model.Title"</h1>



<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h2 class="card-title h5 mb-0">Project Details</h2>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Student Name:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.Name)</dd>

            <dt class="col-sm-4">Student Matric No.:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.StudentNo)</dd>

            <dt class="col-sm-4">Academic Program:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Student.AcademicProgram.Name)</dd>

            <dt class="col-sm-4">Project Type:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.ProjectType)</dd>

            <dt class="col-sm-4">Submission Date:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.SubmissionDate)</dd>

            <dt class="col-sm-4">Current Status:</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>

            <dt class="col-sm-4">Main Supervisor:</dt>
            <dd class="col-sm-8">
                @if (Model.MainSupervisorLecturer != null)
                {
                    <span>@Model.MainSupervisorLecturer.Name (@Model.MainSupervisorLecturer.StaffNo)</span>
                }
                else
                {
                    <span class="text-danger">Not Assigned (Warning: Supervisor conflict check may be affected)</span>
                }
            </dd>
        </dl>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Warning!</strong> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AssignEvaluatorDetails" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Evaluator1Id" class="form-label"></label>
                <select asp-for="Evaluator1Id" class="form-select" asp-items="ViewBag.Evaluator1Id">
                    <option value="">-- Select Evaluator 1 --</option> @* Add an empty option for no selection *@
                </select>
                <span asp-validation-for="Evaluator1Id" class="text-danger"></span>
                @if (Model.Evaluator1 != null)
                {
                    <small class="form-text text-muted">Current: @Model.Evaluator1.Name</small>
                }
            </div>

            <div class="mb-4">
                <label asp-for="Evaluator2Id" class="form-label"></label>
                <select asp-for="Evaluator2Id" class="form-select" asp-items="ViewBag.Evaluator2Id">
                    <option value="">-- Select Evaluator 2 --</option> @* Add an empty option for no selection *@
                </select>
                <span asp-validation-for="Evaluator2Id" class="text-danger"></span>
                @if (Model.Evaluator2 != null)
                {
                    <small class="form-text text-muted">Current: @Model.Evaluator2.Name</small>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <button type="submit" class="btn btn-success">Save Assignment</button>
                <a asp-action="AssignEvaluators" class="btn btn-link text-decoration-none">Back to List</a>
            </div>
        </form>
    </div>
</div>