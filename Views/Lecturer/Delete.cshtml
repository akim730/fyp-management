@model fypSystem.Models.Lecturer

@{
    ViewData["Title"] = "Delete Lecturer";
}

<h1 class="text-2xl font-bold mb-4">Delete Lecturer</h1>

<h3 class="mb-3">Are you sure you want to delete this?</h3>
<div>
    <h4 class="mb-3">Lecturer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.StaffNo)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.StaffNo)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AcademicProgram)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AcademicProgram.Name)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AcademicRank)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AcademicRank)
        </dd>
        @* You can add more fields here if you wish them to be visible on delete confirmation *@
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>