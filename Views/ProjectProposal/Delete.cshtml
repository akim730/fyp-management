@model fypSystem.Models.ProjectProposal

@{
    ViewData["Title"] = "Delete Project Proposal";
}

<h1 class="display-4 mb-4">Delete Project Proposal</h1>

<h3 class="mb-3 text-danger">Are you sure you want to delete this project proposal?</h3>
<p class="text-muted">This action cannot be undone.</p>
<hr />

@* TempData Messages using Bootstrap Alerts *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Proposal Details</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ProjectType)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ProjectType)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SubmissionDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SubmissionDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Status == ProposalStatus.Approved ? "bg-success" :
                                            Model.Status == ProposalStatus.Rejected ? "bg-danger" :
                                            Model.Status == ProposalStatus.ResubmissionRequired ? "bg-warning text-dark" :
                                            "bg-secondary")">
                    @Html.DisplayFor(model => model.Status)
                </span>
            </dd>

            @if (!string.IsNullOrEmpty(Model.CommitteeFeedback))
            {
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CommitteeFeedback)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CommitteeFeedback)</dd>
            }

            @if (Model.ReviewDate.HasValue)
            {
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReviewDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ReviewDate)</dd>
            }

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Student)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Student.Name)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MainSupervisorLecturer)</dt>
            <dd class="col-sm-9">
                @(Model.MainSupervisorLecturer?.Name ?? "Not Yet Assigned")
            </dd>

            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <dt class="col-sm-3">Uploaded File</dt>
                <dd class="col-sm-9">
                    <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-info" target="_blank">Download Proposal PDF</a>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="mt-4">
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to My Proposals</a>
    </form>
</div>
