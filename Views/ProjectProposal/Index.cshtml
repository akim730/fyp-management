@model IEnumerable<fypSystem.Models.ProjectProposal>

@{
    ViewData["Title"] = "My Project Proposals";
}

<h1 class="text-2xl font-bold mb-4">My Project Proposals</h1>


<p class="mb-4">
    <a asp-action="Create" class="btn btn-primary">Submit New Proposal</a>
</p>

@* TempData Messages using Bootstrap Alerts *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Warning!</strong> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">My Submissions</h5>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info" role="alert">
                You have not submitted any project proposals yet. Click "Submit New Proposal" to get started!
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th>@Html.DisplayNameFor(model => model.ProjectType)</th>
                            <th>@Html.DisplayNameFor(model => model.SubmissionDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.MainSupervisorLecturer)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                <td>@Html.DisplayFor(modelItem => item.ProjectType)</td>
                                <td>@Html.DisplayFor(modelItem => item.SubmissionDate)</td>
                                <td>
                                    <span class="badge @(item.Status == fypSystem.Models.ProposalStatus.Approved ? "bg-success" : item.Status == fypSystem.Models.ProposalStatus.Pending ? "bg-warning text-dark" : item.Status == fypSystem.Models.ProposalStatus.Rejected ? "bg-danger" : "bg-info")">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td>
                                    @(item.MainSupervisorLecturer?.Name ?? "Not Assigned Yet")
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">Details</a>
                                    @if (item.Status == fypSystem.Models.ProposalStatus.Pending || item.Status == fypSystem.Models.ProposalStatus.ResubmissionRequired)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
