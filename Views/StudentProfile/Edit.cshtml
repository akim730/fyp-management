@model fypSystem.Models.Student

@{
    ViewData["Title"] = "My Profile";
}

<h1 class="text-2xl font-bold mb-4">My Profile</h1>


<h4 class="text-2xl font-bold mb-4">Edit Personal Details</h4>

<hr />

@* TempData Messages using Bootstrap Alerts *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Warning!</strong> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            @* Hidden fields for non-editable properties to ensure they are posted back *@
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="StudentNo" />
            <input type="hidden" asp-for="DateOfBirth" />
            <input type="hidden" asp-for="Gender" />
            <input type="hidden" asp-for="AcademicProgramId" />
            <input type="hidden" asp-for="CGPA" />
            <input type="hidden" asp-for="AcademicSession" />
            <input type="hidden" asp-for="Semester" />


            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Personal Details</h5>
                </div>
                <div class="card-body">
                    @* Display non-editable fields using form-control-plaintext *@
                    <div class="row mb-3">
                        <label asp-for="Name" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="Name" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Email" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="Email" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="StudentNo" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="StudentNo" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label">Academic Program</label>
                        <div class="col-sm-8">
                            <input value="@Model.AcademicProgram?.Name" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="CGPA" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="CGPA" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Gender" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="Gender" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="DateOfBirth" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="DateOfBirth" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="AcademicSession" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="AcademicSession" class="form-control-plaintext" readonly />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label asp-for="Semester" class="col-sm-4 col-form-label"></label>
                        <div class="col-sm-8">
                            <input asp-for="Semester" class="form-control-plaintext" readonly />
                        </div>
                    </div>

                    @* Editable fields *@
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @* Supervisor Preference section removed as requested *@

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" asp-controller="Home" class="btn btn-secondary ms-2">Back to Home</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
