@model fypSystem.Models.ProjectProposal
@using fypSystem.Models

@{
    ViewData["Title"] = "Submit Evaluation for " + Model.Title;
    var currentFeedback = ViewBag.CurrentFeedback as string;
    var currentRecommendation = ViewBag.EvaluationStatuses?.SelectedValue;
}

<h1 class="display-4 mb-4">Submit Evaluation for: "@Model.Title"</h1>

<h4 class="mb-3">Project Details</h4>
<hr />

@* TempData Messages using Bootstrap Alerts *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">Proposal Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Student Name:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Student.Name) (@Html.DisplayFor(model => model.Student.StudentNo))</dd>

            <dt class="col-sm-3">Academic Program:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Student.AcademicProgram.Name)</dd>

            <dt class="col-sm-3">Project Type:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ProjectType)</dd>

            <dt class="col-sm-3">Submission Date:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SubmissionDate)</dd>

            <dt class="col-sm-3">Current Status:</dt>
            <dd class="col-sm-9">
                <span class="badge
                    @(Model.Status == ProposalStatus.Approved ? "bg-success" :
                                            Model.Status == ProposalStatus.Pending ? "bg-warning text-dark" :
                                            Model.Status == ProposalStatus.Rejected ? "bg-danger" :
                                            Model.Status == ProposalStatus.ResubmissionRequired ? "bg-warning text-dark" :
                                            "bg-secondary")">
                    @Html.DisplayFor(model => Model.Status)
                </span>
            </dd>

            <dt class="col-sm-3">Main Supervisor:</dt>
            <dd class="col-sm-9">@(Model.MainSupervisorLecturer?.Name ?? "N/A")</dd>

            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <dt class="col-sm-3">Proposal File:</dt>
                <dd class="col-sm-9">
                    <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-info" target="_blank">Download Proposal PDF</a>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">Your Evaluation</h5>
    </div>
    <div class="card-body">
        <form asp-action="SubmitEvaluation" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="evaluationStatus" class="form-label">Recommendation Status</label>
                <select id="evaluationStatus" name="evaluationStatus" class="form-select" asp-items="ViewBag.EvaluationStatuses">
                    <option value="">-- Select Recommendation --</option>
                </select>
                <span class="text-danger">@Html.ValidationMessage("evaluationStatus")</span>
            </div>

            <div class="mb-3">
                <label for="comments" class="form-label">Detailed Comments</label>
                <textarea id="comments" name="comments" class="form-control" rows="5">@currentFeedback</textarea>
                <span class="text-danger">@Html.ValidationMessage("comments")</span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Submit Evaluation</button>
                <a asp-action="ProjectsToEvaluate" class="btn btn-secondary ms-2">Back to Assigned Projects</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
